{
  "name": "lorentz-integration-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Container based integration tests that run a real lorentz binary",
  "type": "module",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=900000 lorentz.integration.test.mjs postgres.driver.test.mjs",
    "test:postgres": "node --test --test-timeout=900000 postgres.driver.test.mjs",
    "test:lorentz": "node --test --test-concurrency=1 --test-timeout=900000 lorentz.integration.test.mjs"
  },
  "devDependencies": {
    "testcontainers": "^11.0.0"
  }
}
