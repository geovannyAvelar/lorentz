# Generated binary. Anchored to the root: build.sh only ever places it there
# (`cp lorentz ../`), and an unanchored "lorentz*" also matches any nested
# file or directory whose name starts with "lorentz" - e.g. src/lorentz.h or
# web/app/api/lorentz/ - silently keeping it out of `git add`.
/lorentz*

# Generated standalone regression test binaries (built via ./build.sh test)
/tar_regression
/gzip_regression
/ptr_response_regression

# Generated lorentz.toml file
lorentz.toml

# Versioning files (generated by Makefile)
version.c
version~

# CMake files generated during compilation
/cmake/
/cmake_ci/
/cmake-build-debug/
/cmake-build-release/
/compile_commands.json

# IDE files
.idea/
*.sw*
.vscode/*
!.vscode/c_cpp_properties.json
/build/
.codechecker/

# __pycache__ files (API tests)
__pycache__/

# When patch fails to apply a patch segment to the original file, it saves the
# temporary original file copy out durably as *.orig, dumps the rejected segment
# to *.rej, and continues trying to apply patch segments.
*.orig
*.rej

# MAC->Vendor database files
tools/manuf.data
tools/manuf.gz
tools/macvendor.db

# Documentation files generated by cmake
src/api/docs/hex

# Test dependencies
/node_modules/

# Test Leftovers
ptr.log

# Test libraries (cloned by test/run.sh)
test/libs/

# Compiled LUA scripts
/src/lua/scripts/*.hex

test/integration/node_modules/
